            <div style="display:flex; align-items:center; gap:6px;">👥 Professional Support</div>
            <div style="display:flex; align-items:center; gap:6px;">📊 High Success Rate</div>
          </div>
        </div>

        <div style="position:relative; height:420px; display:flex; align-items:center; justify-content:center;">
          <div style="position:absolute; inset:0; border-radius:24px; overflow:hidden; background:linear-gradient(135deg,#38bdf8 0%,#2563eb 50%,#1d4ed8 100%); box-shadow:0 20px 40px -10px rgba(37,99,235,0.3);">
            <svg viewBox="0 0 600 400" style="width:100%; height:100%; object-fit:cover;">
