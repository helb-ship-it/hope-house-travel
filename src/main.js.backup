import { initializeApp } from 'firebase/app';
import { getFirestore, collection, addDoc, getDocs, query, where, serverTimestamp, doc, updateDoc, deleteDoc } from 'firebase/firestore';

const firebaseConfig = {
  apiKey: "AIzaSyC7c2BqR7V3hZz...",
  authDomain: "hope-house-travel.firebaseapp.com",
  projectId: "hope-house-travel",
  storageBucket: "hope-house-travel.appspot.com",
  messagingSenderId: "123456",
  appId: "1:123456:web:abc"
};
const app = initializeApp(firebaseConfig);
const db = getFirestore(app);

const DESTS = ["Canada","UK","Norway","USA","Australia","Other Countries"];
let blacklist = [];

async function loadBlacklist() {
  try {
    const snap = await getDocs(collection(db, "blacklist"));
    blacklist = snap.docs.map(d => d.data().phone);
  } catch(e) {
    blacklist = [];
  }
}
loadBlacklist();

function genRef(name){ 
  const p = name.split(' ').map(n => n[0]).join('').toUpperCase().substring(0,2); 
  return 'HH-' + p + '-' + Math.floor(1000 + Math.random() * 9000); 
}

async function createNotification(clientId, title, message){ 
  try { 
    await addDoc(collection(db, "notifications"), { clientId, title, message, read: false, createdAt: serverTimestamp() }); 
  } catch(e) {} 
}

/* ================= LANDING PAGE & APPLICATION ================= */
