          <button id="lpApplyTop" style="background:#2563eb; color:white; padding:10px 22px; border-radius:999px; font-size:12px; font-weight:800; border:none; cursor:pointer; box-shadow:0 4px 14px rgba(37,99,235,0.35);">Apply Now →</button>
        </div>
