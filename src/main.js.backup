              <rect x="80" y="160" width="10" height="180" fill="#ffffff" opacity="0.8"/>
              <rect x="220" y="180" width="22" height="160" fill="#ffffff" opacity="0.8"/>
              <polygon points="231,130 220,180 242,180" fill="#ffffff" opacity="0.8"/>
              <rect x="360" y="210" width="12" height="130" fill="#ffffff" opacity="0.8"/>
              <path d="M 460 340 Q 480 290 510 340 Z" fill="#ffffff" opacity="0.8"/>
              <g transform="translate(280,100) rotate(-12) scale(1.2)">
                <path d="M0,0 L80,-10 L120,0 L80,10 L0,0 Z" fill="#ffffff"/>
                <path d="M40,-5 L20,-35 L50,-5 Z" fill="#e0f2fe"/>
                <path d="M40,5 L20,35 L50,5 Z" fill="#bae6fd"/>
