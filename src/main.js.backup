            </svg>
            <div style="position:absolute; top:28px; right:28px; text-align:right; font-family:'Georgia', serif; font-style:italic; color:white; font-size:22px; font-weight:700; line-height:1.2; text-shadow:0 2px 8px rgba(0,0,0,0.3);">
              New Country<br>New Opportunities<br><span style="color:#facc15; font-style:normal; font-family:sans-serif; font-weight:900; font-size:24px;">Better Future</span>
              <div style="width:90px; height:4px; background:#facc15; border-radius:999px; margin:6px 0 0 auto;"></div>
