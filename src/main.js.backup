    </header>

    <section style="background:linear-gradient(180deg,#e0f2fe 0%,#f0f9ff 40%,#ffffff 100%); position:relative; overflow:hidden; border-bottom:1px solid #f1f5f9;">
      <div style="max-width:1280px; margin:auto; padding:48px 24px 24px; display:grid; grid-template-columns:1fr 1.25fr; gap:32px; min-height:480px; align-items:center;">
        
        <div style="z-index:2;">
          <div style="display:inline-flex; align-items:center; gap:6px; border:1px solid #bae6fd; background:white; padding:6px 14px; border-radius:999px; font-size:11px; font-weight:800; color:#0284c7; box-shadow:0 2px 6px rgba(0,0,0,0.03);">
