const EMAILJS = { SERVICE_ID: "service_xxxxxx", TEMPLATE_ID: "template_xxxxxx", PUBLIC_KEY: "xxxxxxxxxx" };
async function sendEmailAuto(to_email, to_name, password, destination, phone){
  if(EMAILJS.SERVICE_ID.includes("xxxx")) return {ok:false};
  try{
    const res = await fetch("https://api.emailjs.com/api/v1.0/email/send", {
      method:"POST", headers:{"Content-Type":"application/json"},
      body: JSON.stringify({service_id: EMAILJS.SERVICE_ID, template_id: EMAILJS.TEMPLATE_ID, user_id: EMAILJS.PUBLIC_KEY, template_params:{to_email, to_name, password, destination, phone, login_link:"https://hope-house-travel.web.app/#client-login"}})
    });
    return {ok:res.ok};
  }catch(e){ return {ok:false}; }
}
async function createNotification(clientId, title, message){
  try{ await addDoc(collection(db,"notifications"), {clientId, title, message, read:false, createdAt:serverTimestamp()}); }catch(e){}
}

